mixin icon(name, size = 20)
  svg.ui-icon(width=size height=size viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
    case name
      when "grid"
        rect(x="3" y="3" width="7" height="7" rx="1.5")
        rect(x="14" y="3" width="7" height="7" rx="1.5")
        rect(x="3" y="14" width="7" height="7" rx="1.5")
        rect(x="14" y="14" width="7" height="7" rx="1.5")
      when "map"
        path(d="m9 4-6 3v14l6-3 6 3 6-3V4l-6 3-6-3Z M9 4v14 M15 7v14")
      when "layers"
        path(d="m12 3 10 5-10 5L2 8l10-5Z M2 12l10 5 10-5 M2 16l10 5 10-5")
      when "orders"
        rect(x="5" y="4" width="14" height="17" rx="2")
        path(d="M9 4V2h6v2 M9 9h6 M9 13h6 M9 17h3")
      when "users"
        circle(cx="9" cy="8" r="3")
        path(d="M3 21v-2a6 6 0 0 1 12 0v2 M16 5a3 3 0 0 1 0 6 M18 15a5 5 0 0 1 3 4v2")
      when "mail"
        rect(x="3" y="5" width="18" height="14" rx="2")
        path(d="m3 6 9 7 9-7")
      when "ticket"
        path(d="M3 8V5h18v3a4 4 0 0 0 0 8v3H3v-3a4 4 0 0 0 0-8Z M14 5v2 M14 11v2 M14 17v2")
      when "settings"
        path(d="M4 7h6 M14 7h6 M4 17h10 M18 17h2 M10 4v6 M18 14v6")
        circle(cx="12" cy="7" r="2")
        circle(cx="16" cy="17" r="2")
      when "user"
        circle(cx="12" cy="8" r="4")
        path(d="M4 21v-1a8 8 0 0 1 16 0v1")
      when "external"
        path(d="M14 3h7v7 M21 3 10 14 M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5")
      when "logout"
        path(d="M9 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h4 M14 8l5 4-5 4 M8 12h11")
      when "search"
        circle(cx="10.5" cy="10.5" r="6.5")
        path(d="m16 16 5 5")
      when "menu"
        rect(x="3" y="4" width="18" height="16" rx="2")
        path(d="M9 4v16")
      when "plus"
        path(d="M12 5v14 M5 12h14")
      when "arrow"
        path(d="M5 12h14 m-6-6 6 6-6 6")
      when "trash"
        path(d="M3 6h18 M9 6V3h6v3 M5 6l1 15h12l1-15 M10 10v7 M14 10v7")
      when "edit"
        path(d="m15 4 5 5 M4 20l5-1L21 7l-5-5L4 14v6Z")
      when "calendar"
        rect(x="3" y="5" width="18" height="16" rx="2")
        path(d="M7 3v4 M17 3v4 M3 11h18 M7 15h2 M15 15h2")
      when "filter"
        path(d="M3 5h18l-7 8v6l-4 2v-8L3 5Z")
      when "wallet"
        rect(x="3" y="5" width="18" height="15" rx="2")
        path(d="M3 8V4a1 1 0 0 1 1-1h14 M16 11h5v5h-5a2.5 2.5 0 0 1 0-5Z")
      when "clock"
        circle(cx="12" cy="12" r="9")
        path(d="M12 7v5l3 2")
      when "check"
        path(d="m5 12 4 4L19 6")
      when "chevron"
        path(d="m9 5 7 7-7 7")
      when "plane"
        path(d="m21 3-7 18-3-8-8-3L21 3Z M11 13 21 3")
      when "refresh"
        path(d="M20 7v5h-5 M4 17v-5h5 M6 6a8 8 0 0 1 14 6 M18 18a8 8 0 0 1-14-6")
      default
        circle(cx="12" cy="12" r="8")
