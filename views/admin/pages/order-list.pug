extends ../layouts/default.pug
include ../mixins/page-header.pug

block main
  +page-header("Đơn đặt tour", "Theo dõi yêu cầu đặt chỗ, thanh toán và trạng thái xử lý.")
  section.panel.list-panel
    .table-toolbar
      .inner-search
        +icon("search", 18)
        input(type="search" search placeholder="Mã đơn, tên hoặc số điện thoại..." aria-label="Tìm đơn hàng")
      .toolbar-filters
        select(filter-status aria-label="Trạng thái đơn hàng")
          option(value="") Tất cả trạng thái
          option(value="initial") Chờ xử lý
          option(value="done") Hoàn thành
          option(value="cancel") Đã hủy
        button.filter-reset(type="button" filter-reset title="Xóa bộ lọc" aria-label="Xóa bộ lọc")
          +icon("refresh", 17)
    p.table-scroll-hint Vuốt ngang để xem các cột còn lại.
    .table-2
      table
        thead
          tr
            th Mã đơn / khách hàng
            th Hành trình
            th Thanh toán
            th Trạng thái
            th Ngày đặt
            th.action-cell Chi tiết
        tbody
          each order in orderList
            tr
              td
                a.cell-primary.inner-code(href=`/${pathAdmin}/order/edit/${order.id}`) #{order.code}
                .cell-primary #{order.fullName}
                .cell-secondary #{order.phone}
                if order.paymentReview
                  span.badge.badge-red Cần đối soát
              td
                .order-tours
                  each item in order.items
                    .cell-primary #{item.name}
                    .cell-secondary #{item.quantityAdult} người lớn · #{item.quantityChildren} trẻ em · #{item.quantityBaby} em bé
              td
                strong.money #{Number(order.total || 0).toLocaleString("vi-VN")}₫
                .cell-secondary #{order.paymentMethodName}
                span(class=`badge ${order.paymentStatus === "paid" ? "badge-green" : "badge-orange"}`) #{order.paymentStatusName}
              td
                span(class=`badge badge-${order.statusInfo.color}`) #{order.statusInfo.label}
              td
                .cell-primary #{order.createdAtDate}
                .cell-secondary #{order.createdAtTime}
              td.action-cell
                .inner-buttons
                  a.inner-edit(href=`/${pathAdmin}/order/edit/${order.id}` title=(permissions.includes("order-edit") ? "Xử lý đơn hàng" : "Xem chi tiết") aria-label=`Xem đơn ${order.code}`)
                    +icon("arrow", 17)
          if !orderList.length
            tr
              td.empty-cell(colspan="6") Không tìm thấy đơn đặt tour phù hợp.
    include ../partials/section-7.pug
