extends ../layouts/default.pug

block main

  h1.box-title Quản lý đơn hàng

  .section-4
    .inner-wrap
      .inner-item
        i.fa-solid.fa-filter
        span Trạng thái
        select(filter-status aria-label="Trạng thái đơn hàng")
          option(value="") Tất cả
          option(value="initial") Khởi tạo
          option(value="done") Hoàn thành
          option(value="cancel") Đã hủy
      .inner-item.inner-reset(filter-reset) Xóa bộ lọc
  .section-5
    .inner-search
      i.fa-solid.fa-magnifying-glass
      input(type="search" search placeholder="Mã đơn, tên hoặc số điện thoại" aria-label="Tìm đơn hàng")
  //- Section 6
  .section-6
    .table-2
      table
        thead
          tr
            th Mã
            th Thông tin khách
            th Danh sách tour
            th Thanh toán
            th Trạng thái
            th.inner-center Ngày đặt
            th Hành động
        tbody
          each orderDetail in orderList
            tr
              td
                .inner-code #{orderDetail.code}
                if orderDetail.paymentReview
                  .badge.badge-red Cần đối soát
              td
                div Họ tên: #{orderDetail.fullName}
                div SĐT: #{orderDetail.phone}
                div Ghi chú: #{orderDetail.note}
              td
                .inner-list
                  each item in orderDetail.items
                    .inner-item
                      .inner-image
                        img(src=item.avatar, alt="")
                      .inner-info
                        .inner-name #{item.name}
                        .inner-quantity
                          div Người lớn: #{item.quantityAdult} x #{Number(item.priceNewAdult || 0).toLocaleString("vi-VN")}đ
                          div Trẻ em: #{item.quantityChildren} x #{Number(item.priceNewChildren || 0).toLocaleString("vi-VN")}đ
                          div Em bé: #{item.quantityBaby} x #{Number(item.priceNewBaby || 0).toLocaleString("vi-VN")}đ
              td
                div Tạm tính: #{Number(orderDetail.subTotal || 0).toLocaleString("vi-VN")}đ
                div Giảm: #{Number(orderDetail.discount || 0).toLocaleString("vi-VN")}đ
                //- div Mã giảm: TOURMUAHE2024
                div Thanh toán: #{Number(orderDetail.total || 0).toLocaleString("vi-VN")}đ
                div PTTT: #{orderDetail.paymentMethodName}
                div TTTT: #{orderDetail.paymentStatusName}
              td
                div(class=`badge badge-${orderDetail.statusInfo.color}`) #{orderDetail.statusInfo.label}
                //- .badge.badge-green Đã duyệt
                //- .badge.badge-red Đã hủy
              td.inner-center
                div #{orderDetail.createdAtTime}
                div #{orderDetail.createdAtDate}
              td
                .inner-buttons
                  a(href=`/${pathAdmin}/order/edit/${orderDetail.id}` class="inner-edit")
                    <i class="fa-regular fa-pen-to-square"></i>
                  button(class="inner-delete")
                    <i class="fa-regular fa-trash-can"></i>
  //- End Section 6

  include ../partials/section-7.pug
