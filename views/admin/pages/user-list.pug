extends ../layouts/default.pug

block main
  h1.box-title Khách hàng
  p.page-description Thông tin tổng hợp từ các đơn đặt tour. Không bao gồm tài khoản quản trị.
  .section-5
    .inner-search
      i.fa-solid.fa-magnifying-glass
      input(type="search" placeholder="Tìm tên hoặc số điện thoại" search aria-label="Tìm khách hàng")
  .table-2
    table
      thead
        tr
          th Khách hàng
          th Số điện thoại
          th Số đơn đặt
          th Giá trị đã thanh toán
          th Đơn gần nhất
      tbody
        each customer in customerList
          tr
            td #{customer.fullName}
            td #{customer._id}
            td #{customer.orderCount}
            td #{customer.paidTotal.toLocaleString("vi-VN")}đ
            td #{new Date(customer.lastOrder).toLocaleDateString("vi-VN")}
        if !customerList.length
          tr
            td(colspan="5" class="empty-cell") Chưa có khách hàng phù hợp.
  include ../partials/section-7.pug
