extends ../layouts/default.pug
include ../mixins/page-header.pug

block main
  if orderDetail.paymentReview
    .container
      p.payment-warning Thanh toán cần được đối soát: đơn đã hủy, hết thời gian giữ chỗ hoặc có giao dịch thanh toán lặp. Vui lòng liên hệ để xác nhận / hoàn tiền.
  if orderDetail.status === "cancel" && orderDetail.paymentStatus === "unpaid"
    .container
      p.payment-warning Đơn đã hủy. Nếu đơn thanh toán trực tuyến hết hạn giữ chỗ, vui lòng đặt lại.


  +page-header(`Đơn hàng ${orderDetail.code}`, "Thông tin khách hàng, hành trình và lịch sử thanh toán.")
    a.btn.btn-outline(href=`/${pathAdmin}/order/list`) Quay lại danh sách

  //- Section 8
  .section-8
    form(id=(permissions.includes("order-edit") ? "order-edit-form" : "order-view-form"))
      .inner-group(style="display: none;")
        label(for="id" class="inner-label") Id
        input(disabled=!permissions.includes("order-edit") type="text" id="id" name="id" value=orderDetail.id)
      .inner-group
        label(for="fullName" class="inner-label") Tên khách hàng
        input(disabled=!permissions.includes("order-edit") type="text" id="fullName" name="fullName" value=orderDetail.fullName)
      .inner-group
        label(for="phone" class="inner-label") Số điện thoại
        input(disabled=!permissions.includes("order-edit") type="text" id="phone" name="phone" value=orderDetail.phone)
      .inner-group.inner-two-col
        label(for="note" class="inner-label") Ghi chú
        textarea(disabled=!permissions.includes("order-edit") id="note" name="note") #{orderDetail.note}
      .inner-group
        label(for="paymentMethod" class="inner-label") Phương thức thanh toán
        select(disabled id="paymentMethod" name="paymentMethod")
          each item in paymentMethodList
            option(
              value=item.value
              selected=(item.value == orderDetail.paymentMethod)
              ) #{item.label}
      .inner-group
        label(for="paymentStatus" class="inner-label") Trạng thái thanh toán
        select(disabled=(!permissions.includes("order-edit") || ["vnpay", "zalopay"].includes(orderDetail.paymentMethod)) id="paymentStatus" name="paymentStatus")
          each item in paymentStatusList
            option(
              value=item.value
              selected=(item.value == orderDetail.paymentStatus)
              ) #{item.label}
      .inner-group
        label(class="inner-label") Ngày đặt
        input(disabled=!permissions.includes("order-edit") type="datetime-local" value=orderDetail.createdAtFormat readonly)
      .inner-group
        label(for="status" class="inner-label") Trạng thái
        select(disabled=!permissions.includes("order-edit") id="status" name="status")
          each item in statusList
            option(
              value=item.value
              selected=(item.value == orderDetail.status)
              ) #{item.label}
      .inner-group
        label(class="inner-label") Danh sách tour
        .inner-order-list
          each item in orderDetail.items
            .inner-order-item
              .inner-order-image
                img(src=(item.avatar || "/assets/images/tour-placeholder.svg"))
              .inner-order-content
                .inner-order-name #{item.name}
                .inner-order-text
                  div Người lớn: #{item.quantityAdult} x #{Number(item.priceNewAdult || 0).toLocaleString("vi-VN")}đ
                  div Trẻ em: #{item.quantityChildren} x #{Number(item.priceNewChildren || 0).toLocaleString("vi-VN")}đ
                  div Em bé: #{item.quantityBaby} x #{Number(item.priceNewBaby || 0).toLocaleString("vi-VN")}đ
                  div Ngày khởi hành: #{item.departureDateFormat}
                  div Khởi hành tại: #{item.cityName}
      .inner-group
        label(class="inner-label") Thanh toán
        .inner-order-total
          div Tạm tính: #{Number(orderDetail.subTotal || 0).toLocaleString("vi-VN")}đ
          div Giảm: #{Number(orderDetail.discount || 0).toLocaleString("vi-VN")}đ
          //- div Mã giảm: TOURMUAHE2024
          div Thanh toán: <span class="inner-hl">#{Number(orderDetail.total || 0).toLocaleString("vi-VN")}đ</span>
      if permissions.includes("order-edit")
        .inner-button.inner-two-col
          button(type="submit") Lưu thay đổi
    .inner-back
      a(href=`/${pathAdmin}/order/list`) Quay lại danh sách
  //- End Section 8
  if payments.length
    .section-3
      .inner-title Lịch sử giao dịch trực tuyến
      .table-2
        table
          thead
            tr
              th Cổng thanh toán
              th Mã giao dịch nội bộ
              th Mã giao dịch cổng
              th Số tiền
              th Trạng thái
          tbody
            each payment in payments
              tr
                td #{payment.provider}
                td #{payment.reference}
                td #{payment.providerTransaction || "—"}
                td #{payment.amount.toLocaleString("vi-VN")}đ
                td #{payment.status === "paid" ? "Đã thanh toán" : payment.status === "failed" ? "Thất bại" : "Đang chờ"}
