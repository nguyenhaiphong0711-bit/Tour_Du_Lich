extends ../layouts/default.pug

block main
  if (permissions.includes("dashboard-view"))
    .workspace-intro
      .intro-copy
        span.eyebrow KHÔNG GIAN ĐIỀU HÀNH
        h1 Chào #{account.fullName},
        p Mỗi hành trình tốt bắt đầu từ sự chuẩn bị chu đáo.
        if permissions.includes("tour-create")
          a.intro-button(href=`/${pathAdmin}/tour/create`)
            i.fa-solid.fa-plus
            |  Tạo chuyến đi mới
      .intro-mark(aria-hidden="true")
        i.fa-regular.fa-compass

    //- Section 1
    .section-1
      .inner-item
        .inner-icon
          img(src="/admin/assets/images/section-1-icon-1.svg", alt="")
        .inner-content
          .inner-title Tài khoản quản trị
          .inner-number #{overview.totalAdmin.toLocaleString("vi-VN")}
      .inner-item
        .inner-icon
          img(src="/admin/assets/images/section-1-icon-2.svg", alt="")
        .inner-content
          .inner-title Đơn hàng
          .inner-number #{overview.totalOrder.toLocaleString("vi-VN")}
      .inner-item
        .inner-icon
          img(src="/admin/assets/images/section-1-icon-3.svg", alt="")
        .inner-content
          .inner-title Doanh thu đã thanh toán
          .inner-number #{overview.totalRevenue.toLocaleString("vi-VN")}đ
    //- End Section 1

    //- Section 2
    .section-2
      .inner-head
        .inner-title Biểu đồ doanh thu
        .inner-filter
          input(type="month" input-change-month)
      .inner-chart
        canvas(id="revenue-chart")
    //- End Section 2

    //- Section 3
    .section-3
      .inner-title Đơn hàng mới
      .table-1
        table
          thead
            tr
              th Mã
              th Thông tin khách
              th Danh sách tour
              th Thanh toán
              th Trạng thái
              th.text-right Ngày đặt
          tbody
            each order in recentOrders
              tr
                td
                  a.inner-code(href=`/${pathAdmin}/order/edit/${order.id}`) #{order.code}
                td
                  div #{order.fullName}
                  .inner-time #{order.phone}
                td
                  each item in order.items
                    div #{item.name}
                td
                  strong #{Number(order.total || 0).toLocaleString("vi-VN")}đ
                  div #{order.paymentStatus === "paid" ? "Đã thanh toán" : "Chưa thanh toán"}
                td
                  - const info = statusList.find(item => item.value === order.status) || { label: "Chưa xác định", color: "orange" }
                  span(class=`badge badge-${info.color}`) #{info.label}
                td.text-right #{moment(order.createdAt).format("DD/MM/YYYY HH:mm")}
