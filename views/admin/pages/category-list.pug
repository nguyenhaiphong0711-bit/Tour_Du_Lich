extends ../layouts/default.pug
include ../mixins/page-header.pug
include ../mixins/change-status.pug

block main
  +page-header("Danh mục tour", "Sắp xếp hành trình theo hệ thống danh mục do bạn tạo.")
    if permissions.includes("category-create")
      a.btn.btn-primary(href=`/${pathAdmin}/category/create`)
        +icon("plus", 18)
        | Tạo danh mục
  section.panel.list-panel
    .table-toolbar
      .inner-search
        +icon("search", 18)
        input(type="search" search placeholder="Tìm tên danh mục..." aria-label="Tìm danh mục")
      .toolbar-filters
        select(filter-status aria-label="Trạng thái danh mục")
          option(value="") Tất cả trạng thái
          option(value="active") Hoạt động
          option(value="inactive") Tạm dừng
        button.filter-reset(type="button" filter-reset title="Xóa bộ lọc" aria-label="Xóa bộ lọc")
          +icon("refresh", 17)
    - const categoryActions = []
    - if (permissions.includes("category-edit")) categoryActions.push({label: "Hoạt động", value: "active"}, {label: "Tạm dừng", value: "inactive"})
    - if (permissions.includes("category-delete")) categoryActions.push({label: "Xóa danh mục", value: "delete"})
    if categoryActions.length
      .bulk-toolbar
        span Chọn danh mục để thao tác hàng loạt
        +change-status(`/${pathAdmin}/category/change-multi`, categoryActions)
    p.table-scroll-hint Vuốt ngang để xem các cột còn lại.
    .table-2
      table
        thead
          tr
            th.check-cell
              input(type="checkbox" class="inner-check" check-all aria-label="Chọn tất cả danh mục trên trang")
            th Danh mục
            th Thứ tự
            th Trạng thái
            th Người tạo
            th Cập nhật gần nhất
            th.action-cell Thao tác
        tbody
          each item in categoryList
            tr
              td.check-cell
                input(type="checkbox" class="inner-check" check-item=item.id aria-label=`Chọn ${item.name}`)
              td
                .tour-identity
                  img(src=(item.avatar || "/assets/images/tour-placeholder.svg") alt="" loading="lazy")
                  div
                    .cell-primary #{item.name}
                    .cell-secondary #{item.parent ? "Danh mục con" : "Danh mục gốc"}
              td #{item.position}
              td
                span(class=`badge ${item.status === "active" ? "badge-green" : "badge-muted"}`) #{item.status === "active" ? "Hoạt động" : "Tạm dừng"}
              td
                .cell-primary #{item.createdByFullName || "—"}
                .cell-secondary #{item.createdAtFormat}
              td
                .cell-primary #{item.updatedByFullName || "—"}
                .cell-secondary #{item.updatedAtFormat}
              td.action-cell
                .inner-buttons
                  if permissions.includes("category-edit")
                    a.inner-edit(href=`/${pathAdmin}/category/edit/${item.id}` title="Chỉnh sửa" aria-label=`Chỉnh sửa ${item.name}`)
                      +icon("edit", 17)
                  if permissions.includes("category-delete")
                    button.inner-delete(type="button" button-delete data-api=`/${pathAdmin}/category/delete/${item.id}` title="Xóa danh mục" aria-label=`Xóa ${item.name}`)
                      +icon("trash", 17)
          if !categoryList.length
            tr
              td.empty-cell(colspan="7") Không tìm thấy danh mục phù hợp.
    include ../partials/section-7.pug
