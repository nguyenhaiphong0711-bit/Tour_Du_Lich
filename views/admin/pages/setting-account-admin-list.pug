extends ../layouts/default.pug

block main

  h1.box-title Tài khoản quản trị

  .section-4
    .inner-wrap
      .inner-item
        select(filter-status aria-label="Trạng thái tài khoản")
          option(value="") Tất cả trạng thái
          option(value="initial") Chờ kích hoạt
          option(value="active") Hoạt động
          option(value="inactive") Tạm dừng
      .inner-item.inner-reset(filter-reset) Xóa bộ lọc
  .section-5
    .inner-wrap
      .inner-search
        i.fa-solid.fa-magnifying-glass
        input(type="search" search placeholder="Tìm kiếm" aria-label="Tìm kiếm")
      .inner-button-create
        a(href=`/${pathAdmin}/setting/account-admin/create`) + Tạo mới
  //- Section 6
  .section-6
    .table-2
      table
        thead
          tr
            th Họ tên
            th(class="inner-center") Ảnh đại diện
            th Email
            th Số điện thoại
            th Nhóm quyền
            th Chức vụ
            th Trạng thái
            th Hành động
        tbody
          each item in accountAdminList
            tr
              td #{item.fullName}
              td(class="inner-center")
                img(src=(item.avatar || "/assets/images/tour-placeholder.svg") class="inner-avatar")
              td #{item.email}
              td #{item.phone}
              td #{item.roleName}
              td #{item.positionCompany}
              td
                if (item.status == "initial")
                  .badge.badge-orange Khởi tạo
                else if (item.status == "active")
                  .badge.badge-green Hoạt động
                else if (item.status == "inactive")
                  .badge.badge-red Tạm dừng
              td
                .inner-buttons
                  a(href=`/${pathAdmin}/setting/account-admin/edit/${item.id}` class="inner-edit")
                    <i class="fa-regular fa-pen-to-square"></i>
                  button(
                    class="inner-delete"
                    button-delete
                    data-api=`/${pathAdmin}/setting/account-admin/delete/${item.id}`
                    )
                    <i class="fa-regular fa-trash-can"></i>
  //- End Section 6

  include ../partials/section-7.pug
