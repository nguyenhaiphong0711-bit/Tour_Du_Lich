extends ../layouts/default.pug
include ../mixins/options.pug
include ../mixins/page-header.pug

block main
  +page-header("Chỉnh sửa tour", "Cập nhật nội dung, giá bán và số chỗ của hành trình.")
    a.btn.btn-outline(href=`/${pathAdmin}/tour/list`)
      +icon("arrow", 17)
      | Danh sách tour
  - const editing = true
  - const formTour = editing ? tourDetail : { status: "active", locations: [], images: [], schedules: [] }
  include ../partials/tour-form.pug
