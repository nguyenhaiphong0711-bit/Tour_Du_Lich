extends ../layouts/default.pug

block main

  h1.box-title Thông tin liên hệ

  .section-5
    .inner-search
      i.fa-solid.fa-magnifying-glass
      input(type="search" search placeholder="Tìm email nhận tin" aria-label="Tìm email nhận tin")
  //- Section 6
  .section-6
    .table-2
      table
        thead
          tr
            th Email
            th Ngày tạo
            th(class="inner-center") Hành động
        tbody
          each item in contactList
            tr
              td #{item.email}
              td #{item.createdAtFormat}
              td(class="inner-center")
                if permissions.includes("contact-delete")
                  .inner-buttons
                    button(
                      class="inner-delete"
                      button-delete
                      data-api=`/${pathAdmin}/contact/delete/${item.id}`
                      )
                      <i class="fa-regular fa-trash-can"></i>
  //- End Section 6

  include ../partials/section-7.pug
