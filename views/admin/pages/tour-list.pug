extends ../layouts/default.pug
include ../mixins/page-header.pug
include ../mixins/change-status.pug

block main
  +page-header("Quản lý tour", "Tạo, cập nhật và theo dõi các hành trình của bạn.")
    if permissions.includes("tour-trash")
      a.btn.btn-outline(href=`/${pathAdmin}/tour/trash`)
        +icon("trash", 17)
        | Thùng rác
    if permissions.includes("tour-create")
      a.btn.btn-primary(href=`/${pathAdmin}/tour/create`)
        +icon("plus", 18)
        | Tạo tour mới
  .list-metrics
    .list-metric
      span Tất cả tour
      strong #{summary.total}
    .list-metric
      span Đang hoạt động
      strong #{summary.active}
      i.status-dot.green
    .list-metric
      span Đang tạm dừng
      strong #{summary.inactive}
      i.status-dot.amber
  section.panel.list-panel
    .table-toolbar
      .inner-search
        +icon("search", 18)
        input(type="search" placeholder="Tìm theo tên tour..." search aria-label="Tìm tour")
      .toolbar-filters
        select(filter-status aria-label="Trạng thái tour")
          option(value="") Tất cả trạng thái
          option(value="active") Hoạt động
          option(value="inactive") Tạm dừng
        select(filter-category aria-label="Danh mục tour")
          option(value="") Tất cả danh mục
          each category in categoryList
            option(value=category.id) #{category.name}
        details.filter-more
          summary.btn.btn-outline
            +icon("filter", 16)
            | Bộ lọc
          .filter-popover
            label Người tạo
              select(filter-created-by)
                option(value="") Tất cả người tạo
                each author in accountAdminList
                  option(value=author.id) #{author.fullName}
            label Từ ngày
              input(type="date" filter-start-date)
            label Đến ngày
              input(type="date" filter-end-date)
        button.filter-reset(type="button" filter-reset title="Xóa bộ lọc" aria-label="Xóa bộ lọc")
          +icon("refresh", 17)
    if permissions.includes("tour-edit") || permissions.includes("tour-delete")
      .bulk-toolbar
        span.selection-count Chọn tour để thao tác hàng loạt
        +change-status(`/${pathAdmin}/tour/change-multi`, bulkActions)
    p.table-scroll-hint Vuốt ngang để xem các cột còn lại.
    .table-2.tour-table
      table
        thead
          tr
            th.check-cell
              input(type="checkbox" class="inner-check" check-all aria-label="Chọn tất cả tour trên trang")
            th Thông tin tour
            th Giá người lớn
            th Số chỗ còn
            th Trạng thái
            th Cập nhật
            th.action-cell Thao tác
        tbody
          each item in tourList
            tr
              td.check-cell
                input(type="checkbox" class="inner-check" check-item=item.id aria-label=`Chọn ${item.name}`)
              td
                .tour-identity
                  img(src=(item.avatar || "/assets/images/tour-placeholder.svg") alt="" loading="lazy")
                  div
                    if permissions.includes("tour-edit")
                      a.cell-primary(href=`/${pathAdmin}/tour/edit/${item.id}`) #{item.name}
                    else
                      span.cell-primary #{item.name}
                    .cell-secondary #{categoryNames[item.category] || "Chưa có danh mục"}
                    .tour-meta
                      span
                        +icon("calendar", 13)
                        | #{item.departureDateFormat || "Chưa có lịch"}
                      if item.time
                        span · #{item.time}
              td
                strong.money #{Number(item.priceNewAdult || 0).toLocaleString("vi-VN")}₫
                if item.priceAdult > item.priceNewAdult
                  .cell-secondary.old-price #{Number(item.priceAdult).toLocaleString("vi-VN")}₫
                .cell-secondary Trẻ em: #{Number(item.priceNewChildren || 0).toLocaleString("vi-VN")}₫
              td
                strong.stock-count #{Number(item.stockAdult || 0)}
                span.cell-secondary  người lớn
                .cell-secondary TE: #{item.stockChildren || 0} · EB: #{item.stockBaby || 0}
              td
                span(class=`badge ${item.status === "active" ? "badge-green" : "badge-muted"}`) #{item.status === "active" ? "Hoạt động" : "Tạm dừng"}
              td
                .cell-primary #{item.updatedAtDate}
                .cell-secondary #{item.updatedByFullName || "—"}
              td.action-cell
                .inner-buttons
                  if permissions.includes("tour-edit")
                    a.inner-edit(href=`/${pathAdmin}/tour/edit/${item.id}` title="Chỉnh sửa tour" aria-label=`Chỉnh sửa ${item.name}`)
                      +icon("edit", 17)
                  if permissions.includes("tour-delete")
                    button.inner-delete(type="button" button-delete data-api=`/${pathAdmin}/tour/delete/${item.id}` title="Chuyển vào thùng rác" aria-label=`Xóa ${item.name}`)
                      +icon("trash", 17)
          if !tourList.length
            tr
              td.empty-cell(colspan="7")
                +icon("search", 30)
                strong Không tìm thấy tour phù hợp
                p Thử thay đổi từ khóa hoặc bộ lọc.
    include ../partials/section-7.pug
