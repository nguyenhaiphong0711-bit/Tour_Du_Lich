extends ../layouts/default.pug
include ../mixins/change-status.pug

block main
  if (permissions.includes("tour-view"))
    h1.box-title Quản lý tour

    //- Section 4
    .section-4
      .inner-wrap
        .inner-item
          <i class="fa-solid fa-filter"></i> Bộ lọc
        .inner-item
          select(filter-status)
            option(value="") Trạng thái
            option(value="active") Hoạt động
            option(value="inactive") Tạm dừng
        .inner-item
          select(filter-created-by)
            option(value="") Người tạo
            each author in accountAdminList
              option(value=author.id) #{author.fullName}
        .inner-item
          input(type="date" filter-start-date aria-label="Từ ngày")
          span –
          input(type="date" filter-end-date aria-label="Đến ngày")
        .inner-item
          select(filter-category)
            option(value="") Danh mục
            each category in categoryList
              option(value=category.id) #{category.name}
        .inner-item.inner-reset(filter-reset)
          <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
    //- End Section 4

    //- Section 5
    .section-5
      .inner-wrap
        if (permissions.includes("tour-edit"))
          +change-status(
            `/${pathAdmin}/tour/change-multi`,
            [
              {
                label: "Hoạt động",
                value: "active"
              },
              {
                label: "Tạm dừng",
                value: "inactive"
              },
              {
                label: "Xóa",
                value: "delete"
              }
            ]
          )
        .inner-search
          <i class="fa-solid fa-magnifying-glass"></i>
          input(type="text" placeholder="Tìm tour theo tên" search aria-label="Tìm tour")
        if (permissions.includes("tour-create"))
          .inner-button-create
            a(href=`/${pathAdmin}/tour/create`) + Tạo mới
        if (permissions.includes("tour-trash"))
          .inner-button-trash
            a(href=`/${pathAdmin}/tour/trash`) Thùng rác
    //- End Section 5

    //- Section 6
    .section-6
      .table-2
        table
          thead
            tr
              th
                input(type="checkbox" class="inner-check" check-all)
              th Tên tour
              th(class="inner-center") Ảnh đại diện
              th Giá
              th Còn lại
              th(class="inner-center") Vị trí
              th(class="inner-center") Trạng thái
              th Tạo bởi
              th Cập nhật bởi
              th Hành động
          tbody
            each item in tourList
              tr
                td
                  input(type="checkbox" class="inner-check" check-item=item.id)
                td #{item.name}
                td(class="inner-center")
                  img(src=(item.avatar || "/assets/images/tour-placeholder.svg") class="inner-avatar")
                td
                  div NL: #{Number(item.priceNewAdult || 0).toLocaleString("vi-VN")}đ
                  div TE: #{Number(item.priceNewChildren || 0).toLocaleString("vi-VN")}đ
                  div EB: #{Number(item.priceNewBaby || 0).toLocaleString("vi-VN")}đ
                td
                  div NL: #{item.stockAdult}
                  div TE: #{item.stockChildren}
                  div EB: #{item.stockBaby}
                td(class="inner-center") #{item.position}
                td(class="inner-center")
                  if (item.status == "active")
                    .badge.badge-green Hoạt động
                  else if (item.status == "inactive")
                    .badge.badge-red Tạm dừng
                td
                  div #{item.createdByFullName}
                  div.inner-time #{item.createdAtFormat}
                td
                  div #{item.updatedByFullName}
                  div.inner-time #{item.updatedAtFormat}
                td
                  .inner-buttons
                    if (permissions.includes("tour-edit"))
                      a(href=`/${pathAdmin}/tour/edit/${item.id}` class="inner-edit")
                        <i class="fa-regular fa-pen-to-square"></i>
                    if (permissions.includes("tour-delete"))
                      button(
                        class="inner-delete"
                        button-delete
                        data-api=`/${pathAdmin}/tour/delete/${item.id}`
                        )
                        <i class="fa-regular fa-trash-can"></i>
    //- End Section 6

    include ../partials/section-7.pug
