extends ../layouts/default.pug
include ../mixins/page-header.pug

block main
  
  +page-header("Đổi mật khẩu", "Cập nhật mật khẩu cho tài khoản đang đăng nhập.")

  //- Section 8
  .section-8
    form(id="profile-change-password-form")
      .inner-group
        label(for="password" class="inner-label") Mật khẩu mới
        input(type="password" id="password" name="password")
      .inner-group
        label(for="confirmPassword" class="inner-label") Nhập lại mật khẩu mới
        input(type="password" id="confirmPassword" name="confirmPassword")
      .inner-button.inner-two-col
        button Đổi mật khẩu
  //- End Section 8