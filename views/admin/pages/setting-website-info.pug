extends ../layouts/default.pug
include ../mixins/page-header.pug
include ../mixins/options.pug

block main

  +page-header("Thông tin website", "Thông tin liên hệ, nhận diện và tài khoản ngân hàng.")

  //- Section 8
  .section-8
    form(id="setting-website-info-form")
      .inner-group
        label(for="websiteName" class="inner-label") Tên website
        input(type="text" id="websiteName" name="websiteName" value=record.websiteName)
      .inner-group
        label(for="phone" class="inner-label") Số điện thoại
        input(type="text" id="phone" name="phone" value=record.phone)
      .inner-group
        label(for="email" class="inner-label") Email
        input(type="email" id="email" name="email" value=record.email)
      .inner-group
        label(for="address" class="inner-label") Địa chỉ
        input(type="text" id="address" name="address" value=record.address)
      .inner-group
        label(for="logo" class="inner-label") Logo
        .inner-upload-image(image-default=record.logo)
          input(
            type="file"
            id="logo"
            name="logo"
            filepond-image
            )
        p.field-hint
          a(href=`/${pathAdmin}/setting/branding`) Mở mục Logo trang chủ để xem khung hiển thị.
      .inner-group
        label(for="favicon" class="inner-label") Favicon
        .inner-upload-image(image-default=record.favicon)
          input(
            type="file"
            id="favicon"
            name="favicon"
            filepond-image
            )
      .inner-group
        label(for="categoryIdSection4" class="inner-label") Danh mục ưu tiên trên trang chủ
        select(id="categoryIdSection4" name="categoryIdSection4")
          option(value="") -- Theo thứ tự danh mục --
          +options(categoryList, 0, record.categoryIdSection4)
      .inner-group
        label.inner-label(for="bankName") Ngân hàng nhận chuyển khoản
        input#bankName(name="bankName" value=record.bankName placeholder="Để trống nếu chưa nhận chuyển khoản")
      .inner-group
        label.inner-label(for="bankAccountName") Tên chủ tài khoản
        input#bankAccountName(name="bankAccountName" value=record.bankAccountName)
      .inner-group
        label.inner-label(for="bankAccountNumber") Số tài khoản
        input#bankAccountNumber(name="bankAccountNumber" value=record.bankAccountNumber)
      .inner-button.inner-two-col
        button Cập nhật
    .inner-back
      a(href=`/${pathAdmin}/setting/list`) Quay lại danh sách
  //- End Section 8
