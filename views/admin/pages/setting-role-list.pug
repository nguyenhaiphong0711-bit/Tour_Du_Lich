extends ../layouts/default.pug

block main

  h1.box-title Nhóm quyền

  .section-5
    .inner-wrap
      .inner-search
        i.fa-solid.fa-magnifying-glass
        input(type="search" search placeholder="Tìm kiếm" aria-label="Tìm kiếm")
      .inner-button-create
        a(href=`/${pathAdmin}/setting/role/create`) + Tạo mới
  //- Section 6
  .section-6
    .table-2
      table
        thead
          tr
            th Tên nhóm quyền
            th Mô tả ngắn
            th Hành động
        tbody
          each item in roleList
            tr
              td #{item.name}
              td #{item.description}
              td
                .inner-buttons
                  a(
                    href=`/${pathAdmin}/setting/role/edit/${item.id}`
                    class="inner-edit"
                    )
                    <i class="fa-regular fa-pen-to-square"></i>
                  button(
                    class="inner-delete"
                    button-delete
                    data-api=`/${pathAdmin}/setting/role/delete/${item.id}`
                    )
                    <i class="fa-regular fa-trash-can"></i>
  //- End Section 6

  include ../partials/section-7.pug
