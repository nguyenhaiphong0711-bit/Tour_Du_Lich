include ../mixins/icon.pug
header.header
  .header-start
    button.inner-button-menu(type="button" aria-label="Thu gọn hoặc mở menu" aria-controls="admin-sidebar" aria-expanded="false")
      +icon("menu")
    .header-context
      a(href=`/${pathAdmin}`) Không gian quản trị
      +icon("chevron", 12)
      span #{pageTitle}
  .header-tools
    if permissions.includes("tour-view")
      form.global-search(action=`/${pathAdmin}/tour/list` method="get" role="search")
        +icon("search", 18)
        input#global-search(type="search" name="keyword" placeholder="Tìm nhanh tour..." aria-label="Tìm nhanh tour")
        kbd ⌘ K
    a.header-account(href=`/${pathAdmin}/profile/edit` aria-label="Thông tin tài khoản")
      .avatar
        if account.avatar
          img(src=account.avatar alt="")
        else
          span #{(account.fullName || "A").charAt(0).toUpperCase()}
      .account-text
        strong #{account.fullName}
        span #{account.roleName || "Chưa gán nhóm quyền"}
      +icon("chevron", 14)
