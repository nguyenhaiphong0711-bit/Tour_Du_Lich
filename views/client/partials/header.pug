include ../mixins/category-menu.pug
header.header
  .container
    .inner-wrap
      // Menu Mobile
      button.inner-menu-mobile
        i.fa-solid.fa-bars
      // Logo
      .inner-logo
        a(href="/")
          if settingWebsiteInfo.logo
            img.site-logo-image(alt=settingWebsiteInfo.websiteName src=settingWebsiteInfo.logo width="180" height="60")
          span.site-logo-name(hidden=!!settingWebsiteInfo.logo) #{settingWebsiteInfo.websiteName}
      // Menu
      nav.inner-menu
        .inner-overlay
        ul
          li
            a.active(href="/") Trang Chủ
          +category-menu(categoryList)
          li
            a(href="/#lien-he") Liên hệ
      // Cart
      .inner-cart
        a(href="/cart")
          img(
            alt=""
            src="/assets/images/icon-cart.svg"
            )
          span(mini-cart) 0
