footer.footer
  .container
    .inner-top
      .inner-title Đăng ký nhận lịch trình và ưu đãi mới
      form#email-form.inner-form
        input#email-input(placeholder="Email của bạn" name="email" type="email" aria-label="Email nhận tin")
        button Đăng ký
    .inner-middle
      nav.inner-links
        ul
          li
            a(href="/") Trang chủ
          each item in categoryList
            li
              a(href=`/category/${item.slug}`) #{item.name}
          li
            a(href="/#lien-he") Liên hệ
    .inner-bottom
      .inner-copyright © #{new Date().getFullYear()} #{settingWebsiteInfo.websiteName}
      .inner-logo
        a(href="/")
          img(alt=settingWebsiteInfo.websiteName src=settingWebsiteInfo.logo)
