if settingWebsiteInfo.phone || settingWebsiteInfo.email
  .box-contact
    if settingWebsiteInfo.phone
      a(href=`tel:${settingWebsiteInfo.phone}` title="Gọi tư vấn" aria-label="Gọi tư vấn")
        i.fa-solid.fa-phone
    if settingWebsiteInfo.email
      a(href=`mailto:${settingWebsiteInfo.email}` title="Gửi email" aria-label="Gửi email")
        i.fa-solid.fa-envelope
