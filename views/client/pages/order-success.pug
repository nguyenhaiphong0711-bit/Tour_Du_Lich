extends ../layouts/default.pug

block main
  if orderDetail.paymentReview
    .container
      p.payment-warning Thanh toán cần được đối soát: đơn đã hủy, hết thời gian giữ chỗ hoặc có giao dịch thanh toán lặp. Vui lòng liên hệ để xác nhận / hoàn tiền.
  if orderDetail.status === "cancel" && orderDetail.paymentStatus === "unpaid"
    .container
      p.payment-warning Đơn đã hủy. Nếu đơn thanh toán trực tuyến hết hạn giữ chỗ, vui lòng đặt lại.

  .container
    .section-11(style="padding-top: 20px;")
      .inner-wrap
        if orderDetail.status !== "cancel"
          h4(style="color: green;") Đã nhận yêu cầu đặt tour. Vui lòng kiểm tra trạng thái thanh toán bên dưới.
        else
          h4 Đơn đặt tour đã hủy.
        .inner-head
          .inner-title Thông tin đơn hàng
        p Mã đơn hàng: #{orderDetail.code}
        p Tên khách hàng: #{orderDetail.fullName}
        p Số điện thoại: #{orderDetail.phone}
        p Ghi chú: #{orderDetail.note}
        p Phương thức thanh toán: #{orderDetail.paymentMethodName}
        p Trạng thái thanh toán: #{orderDetail.paymentStatusName}
        p Trạng thái đơn hàng: #{orderDetail.statusName}
        p Ngày đặt: #{orderDetail.createdAtFormat}

    .section-11(style="padding-top: 20px;")
      .inner-wrap
        .inner-head
          .inner-title Danh sách tour
        .inner-tour-list
          each item in orderDetail.items
            // Tour Item
            .inner-tour-item
              .inner-actions
              .inner-product
                .inner-image
                  a(href=`/tour/detail/${item.slug}`)
                    img(
                      alt=item.name
                      src=item.avatar
                      )
                .inner-content
                  .inner-title
                    a(href=`/tour/detail/${item.slug}`) #{item.name}
                  .inner-meta
                    .inner-meta-item
                      | Ngày Khởi Hành:
                      b #{item.departureDateFormat}
                    .inner-meta-item
                      | Khởi Hành Tại:
                      b #{item.cityName}
              .inner-quantity
                label.inner-label Số Lượng Hành Khách
                .inner-list
                  .inner-item
                    .inner-item-label Người lớn:
                    .inner-item-price
                      span #{item.quantityAdult}
                      span x
                      span.inner-hl #{Number(item.priceNewAdult || 0).toLocaleString("vi-VN")}
                  .inner-item
                    .inner-item-label Trẻ em:
                    .inner-item-price
                      span #{item.quantityChildren}
                      span x
                      span.inner-hl #{Number(item.priceNewChildren || 0).toLocaleString("vi-VN")}
                  .inner-item
                    .inner-item-label Em bé:
                    .inner-item-price
                      span #{item.quantityBaby}
                      span x
                      span.inner-hl #{Number(item.priceNewBaby || 0).toLocaleString("vi-VN")}
            // End Tour Item
        .inner-list-price
          .inner-item
            .inner-label Tạm tính:
            .inner-price #{Number(orderDetail.subTotal || 0).toLocaleString("vi-VN")}đ
          .inner-item
            .inner-label Giảm:
            .inner-price -#{Number(orderDetail.discount || 0).toLocaleString("vi-VN")}đ
          .inner-item
            .inner-label Thanh toán:
            .inner-price-hl #{Number(orderDetail.total || 0).toLocaleString("vi-VN")}đ
