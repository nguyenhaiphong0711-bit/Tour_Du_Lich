extends ../layouts/default.pug
include ../mixins/product.pug

block main
  // Section 1
  section.section-1
    .container
      .inner-wrap
        h1.inner-title(
          data-aos-duration="800"
          data-aos="fade-up"
          )
          | Một hành trình mới đang chờ bạn
          br
          | Đi nơi đâu bạn muốn
        p.inner-desc(
          data-aos-delay="150"
          data-aos-duration="800"
          data-aos="fade-up"
          )
          | Chọn điểm đến, tìm lịch khởi hành và lên kế hoạch cho chuyến đi theo cách của bạn.
        form.inner-form(
          data-aos-delay="300"
          data-aos-duration="800"
          data-aos="fade-up"
          action=""
          form-search
          )
          .inner-box.inner-address
            .inner-input-group
              img.inner-icon(src="/assets/images/icon-address.svg")
              input.inner-input(
                placeholder="Bạn muốn đi đâu?"
                type="text"
                name="locationTo"
                )
              i.fa-solid.fa-angle-down.inner-down
            .inner-suggest
              .inner-suggest-title
                i.fa-solid.fa-location-dot
                | Địa Điểm Hot
              .inner-suggest-list
                .inner-item
                  .inner-item-image
                    img(
                      alt=""
                      src="/assets/images/product-1.jpg"
                      )
                  .inner-item-content
                    .inner-item-title Nhật Bản
                    .inner-item-desc 50 tours
                .inner-item
                  .inner-item-image
                    img(
                      alt=""
                      src="/assets/images/product-2.jpg"
                      )
                  .inner-item-content
                    .inner-item-title Phú Quốc
                    .inner-item-desc 50 tours
                .inner-item
                  .inner-item-image
                    img(
                      alt=""
                      src="/assets/images/product-3.jpg"
                      )
                  .inner-item-content
                    .inner-item-title Singapore
                    .inner-item-desc 50 tours
                .inner-item
                  .inner-item-image
                    img(
                      alt=""
                      src="/assets/images/product-3.jpg"
                      )
                  .inner-item-content
                    .inner-item-title Singapore
                    .inner-item-desc 50 tours
                .inner-item
                  .inner-item-image
                    img(
                      alt=""
                      src="/assets/images/product-3.jpg"
                      )
                  .inner-item-content
                    .inner-item-title Singapore
                    .inner-item-desc 50 tours
                .inner-item
                  .inner-item-image
                    img(
                      alt=""
                      src="/assets/images/product-3.jpg"
                      )
                  .inner-item-content
                    .inner-item-title Singapore
                    .inner-item-desc 50 tours
                .inner-item
                  .inner-item-image
                    img(
                      alt=""
                      src="/assets/images/product-3.jpg"
                      )
                  .inner-item-content
                    .inner-item-title Singapore
                    .inner-item-desc 50 tours
                .inner-item
                  .inner-item-image
                    img(
                      alt=""
                      src="/assets/images/product-3.jpg"
                      )
                  .inner-item-content
                    .inner-item-title Singapore
                    .inner-item-desc 50 tours
                .inner-item
                  .inner-item-image
                    img(
                      alt=""
                      src="/assets/images/product-3.jpg"
                      )
                  .inner-item-content
                    .inner-item-title Singapore
                    .inner-item-desc 50 tours
                .inner-item
                  .inner-item-image
                    img(
                      alt=""
                      src="/assets/images/product-3.jpg"
                      )
                  .inner-item-content
                    .inner-item-title Singapore
                    .inner-item-desc 50 tours
          .inner-box.inner-user
            .inner-input-group
              img.inner-icon(src="/assets/images/icon-user.svg")
              input.inner-input(
                readonly=""
                value="NL: 1, TE: 0, EB: 0"
                placeholder="Số lượng"
                type="text"
                )
              i.fa-solid.fa-angle-down.inner-down
            .inner-quantity
              .inner-item
                .inner-label Người lớn
                .inner-count
                  span.inner-down -
                  input.inner-number(
                    value="0"
                    readonly
                    name="stockAdult"
                    )
                  span.inner-up +
              .inner-item
                .inner-label Trẻ em
                .inner-count
                  span.inner-down -
                  input.inner-number(
                    value="0"
                    readonly
                    name="stockChildren"
                    )
                  span.inner-up +
              .inner-item
                .inner-label Em bé
                .inner-count
                  span.inner-down -
                  input.inner-number(
                    value="0"
                    readonly
                    name="stockBaby"
                    )
                  span.inner-up +
          .inner-box.inner-calendar
            .inner-input-group
              img.inner-icon(src="/assets/images/icon-calendar.svg")
              input.inner-input(
                placeholder="Lịch khởi hành"
                type="date"
                name="departureDate"
                )
          button.inner-button
            i.fa-solid.fa-magnifying-glass
            | Tìm Kiếm
  // End Section 1
  if tourListSection2.length
    .section-2
      .container
        .inner-wrap
          .inner-info
            h2.inner-title Tour giờ chót
            .inner-desc Ưu đãi cho các chuyến khởi hành trong 30 ngày tới.
            a.button-outline(href="/search") Khám phá chuyến đi
          .inner-list
            .swiper.swiper-section-2
              .swiper-wrapper
                each item in tourListSection2
                  .swiper-slide
                    +product-item(item)
  each section in categorySections
    .section-4
      .container
        h2.box-title #{section.category.name}
        if section.tours.length
          .inner-wrap
            each item in section.tours
              +product-item(item)
        else
          p.no-data Chưa có tour đang mở bán trong danh mục này.
        .inner-button
          a.button-outline(href=`/category/${section.category.slug}`) Xem tất cả
  .section-4#lien-he
    .container
      h2.box-title Cùng lên kế hoạch cho chuyến đi
      p Liên hệ để được tư vấn lịch trình và điểm khởi hành phù hợp.
      if settingWebsiteInfo.phone
        a.button-outline(href=`tel:${settingWebsiteInfo.phone}`) Gọi #{settingWebsiteInfo.phone}
      if settingWebsiteInfo.email
        p
          a(href=`mailto:${settingWebsiteInfo.email}`) #{settingWebsiteInfo.email}
